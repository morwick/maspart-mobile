<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications (APNs). Xcode menggantinya ke "production" saat
	     arsip diekspor untuk TestFlight/App Store. Butuh akun Apple Developer
	     berbayar untuk build ke iPhone asli. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
